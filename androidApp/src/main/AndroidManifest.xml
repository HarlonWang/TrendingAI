<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TrendingApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <!-- 动态图标：LAUNCHER 入口全部由 activity-alias 承担（任何时刻恰好启用一个），
             MainActivity 本体不再直接出现在桌面。alias 的启停由
             shared androidMain Platform.android.kt 的 applyAppIcon() 管理，
             两处的 alias 清单必须一致。 -->
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- OAuth 回跳接收：透明、一闪即逝，投递结果后把 MainActivity 带回前台。
             刻意保持默认 launchMode（同 AppAuth 的 RedirectUriReceiverActivity）——
             不把 OAuth 的特殊需求写进主 Activity 的全局启动语义。 -->
        <activity
            android:name=".AuthRedirectActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!-- 只按 scheme 过滤：回跳 URI 不带 host（cn.trendingai:/auth/callback），
                     而 Android 的 <data> 规则是「没有 host 时所有 path 属性都被忽略」，
                     写了也是摆设。debug/release 各占一个 scheme 来隔离，见 build.gradle.kts -->
                <data android:scheme="${authRedirectScheme}" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityGraphite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite"
            android:roundIcon="@mipmap/ic_launcher_graphite_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivitySteel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_steel"
            android:roundIcon="@mipmap/ic_launcher_steel_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityPine"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pine"
            android:roundIcon="@mipmap/ic_launcher_pine_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityBerry"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_berry"
            android:roundIcon="@mipmap/ic_launcher_berry_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityCream"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cream"
            android:roundIcon="@mipmap/ic_launcher_cream_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
