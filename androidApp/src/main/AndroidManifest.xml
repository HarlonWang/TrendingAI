<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TrendingApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="${appName}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">
        <!-- 动态图标：LAUNCHER 入口全部由 activity-alias 承担（任何时刻恰好启用一个），
             MainActivity 本体不再直接出现在桌面。alias 的启停由
             shared androidMain Platform.android.kt 的 applyAppIcon() 管理，
             两处的 alias 清单必须一致。 -->
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <!-- loginbase OAuth 回跳：系统浏览器完成 GitHub 授权后回到这里，
                 参数带 otc（登录）或 linked/error（绑定身份）。
                 Logto 时代这条由 SDK 的 manifest 合并注入，自建后需自己注册。

                 launchMode=singleTask 是回跳能复用现有实例的条件：默认的 standard
                 会让浏览器在自己的 task 里新建一个 MainActivity——用户看到的是
                 "跳回首页"，而登录面板不在这个新实例上，otc 投到总线后无人消费，
                 登录实际上没完成（2026-08-13 实测）。

                 Logto SDK 走的是另一条路：一个独立的透明 Activity
                 （LogtoRedirectReceiverActivity，无 launchMode）接住回跳，
                 经 SDK 内部静态回调转发后立刻 finish，主 Activity 不受影响。
                 这里选 singleTask 是因为 App 只有一个 Activity，少一个中转件；
                 代价是改变了主 Activity 的全局启动语义。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="${authRedirectScheme}"
                    android:host="${applicationId}"
                    android:pathPrefix="/auth" />
            </intent-filter>
        </activity>

        <activity-alias
            android:name=".MainActivityDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityGraphite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_graphite"
            android:roundIcon="@mipmap/ic_launcher_graphite_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivitySteel"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_steel"
            android:roundIcon="@mipmap/ic_launcher_steel_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityPine"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pine"
            android:roundIcon="@mipmap/ic_launcher_pine_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityBerry"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_berry"
            android:roundIcon="@mipmap/ic_launcher_berry_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".MainActivityCream"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cream"
            android:roundIcon="@mipmap/ic_launcher_cream_round"
            android:label="${appName}"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
