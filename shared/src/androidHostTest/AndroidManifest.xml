<!-- 单测 manifest 合并会拉进 loginbase-kt-browser 的声明，其占位符在本模块无值、
     会让 test 任务构建失败；单测不使用回跳，直接移除这三个节点 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name="wang.harlon.loginbase.browser.LoginbaseCallbackActivity"
            tools:node="remove" />
        <activity
            android:name="wang.harlon.loginbase.browser.LoginbaseAuthActivity"
            tools:node="remove" />
        <meta-data
            android:name="loginbase.redirectScheme"
            tools:node="remove" />
    </application>
</manifest>
